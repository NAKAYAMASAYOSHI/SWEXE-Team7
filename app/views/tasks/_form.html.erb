<%# 登録画面と編集画面で、同じフォームを使う %>
<% if @task.errors.any? %>
  <ul style="color: red;">
    <% @task.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: [@course, @task] do |f| %>
  <%# 項目は、登録のときだけ選べる %>
  <% if @task.new_record? %>
    <p><%= f.label :grade_item_id, "成績の項目" %><br>
      <%= f.collection_select :grade_item_id, @course.grade_items, :id, :name %></p>
  <% end %>
  <p><%= f.label :number, "第何回" %><br><%= f.number_field :number %></p>
  <p><%= f.label :due_on, "締切" %><br><%= f.date_field :due_on %></p>
  <p><%= f.label :status, "状態" %><br><%= f.select :status, Task::STATUSES %></p>
  <p><%= f.label :max_score, "満点（わかれば）" %><br><%= f.number_field :max_score %></p>
  <p><%= f.label :score, "得点（返却済みのときは必須）" %><br><%= f.number_field :score %></p>
  <p><%= f.submit "保存する" %></p>
<% end %>
<p><%= link_to "課題一覧に戻る", course_tasks_path(@course) %></p>
